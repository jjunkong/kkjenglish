{
  "rewrites": [
    {
      "source": "/grading",
      "destination": "/grading.html"
    },
    {
      "source": "/parent",
      "destination": "/index.html"
    },
    {
      "source": "/parent/",
      "destination": "/index.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
