{
  "rewrites": [
    {
      "source": "/grading",
      "destination": "/grading.html"
    },
    {
      "source": "/parent",
      "destination": "/index.html"
    },
    {
      "source": "/parent/",
      "destination": "/index.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/admin/",
      "destination": "/admin.html"
    },
    {
      "source": "/leader",
      "destination": "/leader.html"
    },
    {
      "source": "/leader/",
      "destination": "/leader.html"
    },
    {
      "source": "/student",
      "destination": "/student.html"
    },
    {
      "source": "/student/",
      "destination": "/student.html"
    }
  ],
  "headers": [
    {
      "source": "/(manifest.*\\.json|sw\\.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}