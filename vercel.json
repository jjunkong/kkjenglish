{
  "rewrites": [
    {
      "source": "/grading",
      "destination": "/grading.html"
    }
  ],
  "headers": [
    {
      "source": "/(manifest.*\\.json|sw\\.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
